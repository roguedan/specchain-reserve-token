# Deployment Configuration for Sepolia Testnet
# Copy this to .env and fill in your actual values

# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Issuer address (who can mint tokens) 
ISSUER=0xYourIssuerEOA

# Reserve wallet address (holds backing ETH)
RESERVE=0xYourReserveEOA

# Sepolia RPC URL - get from Infura, Alchemy, or public endpoint
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Alternative public RPC:
# RPC_URL=https://rpc.sepolia.org

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key